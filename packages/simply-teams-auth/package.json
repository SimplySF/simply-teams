{
  "name": "@simplysf/simply-teams-auth",
  "description": "Seamless Microsoft Graph sign-in for simply-teams through the operating system identity broker (WAM)",
  "version": "0.0.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-teams",
  "bugs": "https://github.com/SimplySF/simply-teams/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-teams",
    "directory": "packages/simply-teams-auth"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib"
  ],
  "keywords": [
    "microsoft-teams",
    "teams",
    "microsoft-graph",
    "simply",
    "msal",
    "wam",
    "sso"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.2",
    "@azure/msal-node-extensions": "^5.5.2",
    "@simplysf/simply-teams-core": "workspace:^0.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:coverage": "vitest run --coverage --project simply-teams-auth",
    "test:only": "wireit",
    "test:watch": "vitest watch --project simply-teams-auth"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../simply-teams-core:compile"
      ]
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-teams-core:compile"
      ]
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-teams-core:compile"
      ]
    },
    "test:only": {
      "command": "vitest run --project simply-teams-auth",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts"
      ],
      "output": [],
      "dependencies": [
        "../simply-teams-core:compile"
      ]
    }
  }
}
